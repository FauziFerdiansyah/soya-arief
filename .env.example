# ============================================================
# Konfigurasi Firebase (Vite meng-inline nilai ini ke bundle)
# CATATAN: nilai VITE_* BUKAN rahasia. Semuanya terlihat di
# JavaScript hasil build. Pengamanan data ada di firestore.rules.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Token yang dikirim bersama setiap tulisan admin ke Firestore.
# Harus sama dengan nilai di firestore.rules.
VITE_ADMIN_KEY=

# SHA-256 (hex, huruf kecil) dari password login webadmin.
# Buat dengan: npm run hash:password
VITE_ADMIN_PASSWORD_HASH=

# Base path build. '/soya-arief/' untuk GitHub Pages tanpa domain,
# '/' kalau sudah pakai soyaarief.site
VITE_BASE=/soya-arief/
