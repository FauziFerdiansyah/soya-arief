# ============================================================
# Konfigurasi Firebase (Vite meng-inline nilai ini ke bundle)
# CATATAN: nilai VITE_* BUKAN rahasia. Semuanya terlihat di
# JavaScript hasil build. Pengamanan data ada di firestore.rules.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Login UI tetap memakai username; Firebase Auth memakai email internal.
# Keduanya nilai publik dan memiliki default source berikut.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_EMAIL=admin@soyaarief.site

# Base path build. '/' karena situs dilayani di root soyaarief.site.
# Pakai '/soya-arief/' hanya kalau kembali ke URL project pages.
VITE_BASE=/

# URL publik lengkap situs undangan, dipakai panel admin saat membuat
# link tamu. Wajib diisi supaya link yang dicopy dari localhost tetap
# menunjuk ke domain produksi. Harus diakhiri '/'.
VITE_PUBLIC_URL=
